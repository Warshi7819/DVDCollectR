@page
@model CollectionModel
@{
    ViewData["Title"] = "Collection";
}

<h2 class="mb-4">Collection</h2>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text" class="form-control" name="SearchTitle" placeholder="Search by title..." value="@Model.SearchTitle" />
    </div>
    <div class="col-md-3">
        <input type="text" class="form-control" name="SearchActor" placeholder="Search by actor..." value="@Model.SearchActor" />
    </div>
    <div class="col-md-3">
        <select class="form-select" name="SearchGenre">
            <option value="">All genres</option>
            @foreach (var g in Model.Genres)
            {
                <option value="@g" selected="@(Model.SearchGenre == g)">@g</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (Model.Result is { Items.Count: > 0 })
{
    var start = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var end = Math.Min(Model.CurrentPage * Model.PageSize, Model.Result.TotalCount);

    <p class="text-muted">Showing @start–@end of @Model.Result.TotalCount</p>

    @foreach (var dvd in Model.Result.Items)
    {
        <div class="card mb-3 flex-row shadow-sm">
            <img src="~/images/DVDs/Thumbnails/@(dvd.ProfileId)f.jpg"
                 class="card-img-left" alt="@dvd.Title cover"
                 style="width: 100px; object-fit: cover;"
                 onerror="this.style.display='none'" />
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">
                    <a asp-page="./Details" asp-route-id="@dvd.Id"
                       asp-route-returnPage="@Model.CurrentPage"
                       asp-route-returnTitle="@Model.SearchTitle"
                       asp-route-returnActor="@Model.SearchActor"
                       asp-route-returnGenre="@Model.SearchGenre">@dvd.Title</a>
                </h5>
                @if (dvd.ProductionYear.HasValue)
                {
                    <p class="card-text small mb-1"><strong>Year:</strong> @dvd.ProductionYear</p>
                }
                @if (dvd.RunningTime.HasValue)
                {
                    var hrs = dvd.RunningTime.Value / 60;
                    var mins = dvd.RunningTime.Value % 60;
                    <p class="card-text small mb-1"><strong>Runtime:</strong> @(hrs)h @(mins)m</p>
                }
                @if (dvd.TmdbVoteAverage.HasValue)
                {
                    <p class="card-text small mb-2">
                        <span class="badge bg-warning text-dark">★ @dvd.TmdbVoteAverage.Value.ToString("F1")</span>
                        @if (dvd.TmdbVoteCount.HasValue)
                        {
                            <small class="text-muted ms-1">@dvd.TmdbVoteCount.Value.ToString("N0") votes</small>
                        }
                    </p>
                }
                <div class="mt-auto">
                    @foreach (var genre in dvd.Genres)
                    {
                        <span class="badge bg-info me-1">@genre</span>
                    }
                </div>
            </div>
        </div>
    }

    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-page="./Collection"
                   asp-route-p="@(Model.CurrentPage - 1)"
                   asp-route-SearchTitle="@Model.SearchTitle"
                   asp-route-SearchActor="@Model.SearchActor"
                   asp-route-SearchGenre="@Model.SearchGenre">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.CurrentPage of @Model.Result.TotalPages</span>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-page="./Collection"
                   asp-route-p="@(Model.CurrentPage + 1)"
                   asp-route-SearchTitle="@Model.SearchTitle"
                   asp-route-SearchActor="@Model.SearchActor"
                   asp-route-SearchGenre="@Model.SearchGenre">Next</a>
            </li>
        </ul>
    </nav>
}
else
{
    <div class="alert alert-info">No DVDs found matching your criteria.</div>
}

@section Scripts {
    <script>
        (function() {
            document.querySelectorAll('.card-title a').forEach(function(link) {
                link.addEventListener('click', function() {
                    sessionStorage.setItem('collectionScroll', window.scrollY);
                });
            });

            var scrollY = sessionStorage.getItem('collectionScroll');
            if (scrollY) {
                window.scrollTo(0, parseInt(scrollY, 10));
                sessionStorage.removeItem('collectionScroll');
            }
        })();
    </script>
}
